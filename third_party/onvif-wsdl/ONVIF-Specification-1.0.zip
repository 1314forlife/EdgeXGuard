#main-only {
	width: 100%;
	background-color: #ffffff;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
}

#main-only > .content {
	padding: 5rem 10rem;
}

@media (min-width: 768px) {
	#main-only > .content {
		width: 750px;
	}
}
	
@media (min-width: 992px) {
	#main-only > .content {
		width: 970px;
	}
}

@media (min-width: 1200px) {
	#main-only > .content {
		width: 1170px;
	}
}

